# Tollgate — environment reference (docs/SPEC.md "Conventions"). Copy to .env (gitignored);
# ./scripts/setup.sh does this and generates ADMIN_TOKEN. Everything has a working default except ADMIN_TOKEN.
# One spelling per setting; the gateway, the dashboard and the scripts all read these names.

# --- Admin / auth -----------------------------------------------------------
# Bearer token for /admin/* routes (policy, metrics, audit export, events SSE, approvals, red-team control).
# Required: the gateway exits with code 1 if this is empty, unless TOLLGATE_INSECURE_ADMIN=1.
# Generate: openssl rand -hex 16
ADMIN_TOKEN=
# Allow an empty ADMIN_TOKEN (local demo only; never in the README quickstart).
# TOLLGATE_INSECURE_ADMIN=0

# --- No-models mode (HANDOFF.md §0, SPEC.md §2.1) ---------------------------
# Models may not be pulled yet (arena Wi-Fi). The whole system and the test suite must work without Ollama.
# SEMANTIC_PROVIDER: ollama (real tier-1/tier-2 via Ollama) | mock (deterministic: `unsafe` when the input contains a
#   marker from SEMANTIC_MOCK_MARKERS, the uncertain band for TG-MOCK-UNCERTAIN, else `safe`; fake latency) | off.
# Flip to `ollama` once ./scripts/doctor.sh shows the models present.
SEMANTIC_PROVIDER=mock
SEMANTIC_MOCK_MARKERS=ignore previous instructions,jailbreak,DAN
# UPSTREAM: ollama (forward to policy.upstream.base_url) | echo (built-in canned assistant reply; the X-Tollgate-Echo
#   header can make it return PII / a canary / an exfil link / a tool call so output-path tests run with no model).
UPSTREAM=echo

# --- Upstream model server --------------------------------------------------
# Ollama base URL for the tier-1/tier-2 models and /api/version. Clean traffic goes to policy.upstream.base_url
# (http://127.0.0.1:11434/v1 in policy.yaml). No cloud providers.
OLLAMA_URL=http://127.0.0.1:11434
# Sent as keep_alive on every Ollama call so the models stay resident between requests.
OLLAMA_KEEP_ALIVE=30m

# --- Gateway ----------------------------------------------------------------
# Bun + Hono. Agents point their OpenAI base URL at http://localhost:8787/v1. The dashboard port is fixed by its
# dev script (next dev -p 3000).
TOLLGATE_PORT=8787

# --- Files ------------------------------------------------------------------
# The control catalog. Hot-reloaded on save; an invalid file is rejected and the last good version stays active.
TOLLGATE_POLICY=./policy.yaml
# Historical-attack signature feed (file path or http(s) URL). Overrides controls.signatures.feed in policy.yaml when set.
TOLLGATE_FEED=./feeds/ai-exploits.json
# Runtime data (gitignored): audit.jsonl (hash-chained audit log) and tollgate.db (SQLite: events, budgets, approvals, canaries).
TOLLGATE_DATA_DIR=./data

# --- Demo agent -------------------------------------------------------------
# Model used by `bun run demo` and the playground default. Fallback if it cannot be pulled: qwen2.5:3b.
# The tier-1 classifier and tier-2 judge models are NOT env settings: policy.yaml semantic.classifier_model /
# semantic.judge_model / semantic.jailbreak_model own them.
DEMO_MODEL=llama3.2:3b

# --- Dashboard (public, i.e. visible in the browser bundle) -----------------
# Where the dashboard reaches the gateway. Change only if TOLLGATE_PORT changes.
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
# The dashboard sends ADMIN_TOKEN as NEXT_PUBLIC_ADMIN_TOKEN. For the demo it is acceptable that the token
# is visible client-side; README "Limitations" says so. setup.sh sets it equal to ADMIN_TOKEN.
NEXT_PUBLIC_ADMIN_TOKEN=
# Dashboard-only: serve mock data and a mock SSE stream while the gateway does not exist yet (track B). 0 = live gateway.
# NEXT_PUBLIC_MOCK=0

# --- Tuning (optional) ------------------------------------------------------
# Audit log rotation size in MB (chain continues across files).
# TOLLGATE_AUDIT_MAX_MB=200
# Extra CORS origins for /admin/* and /v1/*, comma-separated (http://localhost:3000 is always allowed).
# TOLLGATE_CORS_ORIGINS=
# Require admin auth on GET /metrics (Prometheus text). Default off so judges can curl it.
# TOLLGATE_METRICS_AUTH=0
