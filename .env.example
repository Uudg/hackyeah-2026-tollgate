# Copy to .env. Every value has a default in code; this file documents them.
OLLAMA_URL=http://localhost:11434
TOLLGATE_PORT=8787
POLICY_PATH=./policy.yaml
FEED_PATH=./feeds/ai-exploits.json
DATA_DIR=./data
# Semantic tiers 1-2: ollama (real models) | mock (deterministic, no models) | off
SEMANTIC_PROVIDER=mock
# Where allowed requests go: ollama (real chat model) | echo (built-in canned upstream, no models)
UPSTREAM=echo
# Dashboard
NEXT_PUBLIC_GATEWAY_URL=http://localhost:8787
